{
  "name": "cypress-framework",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "clean:reports": "rm -rf cypress/reports",
    "pretest": "npm run clean:reports",
    "test": "cypress run --spec 'cypress/e2e/**/*.cy.js' && npm run generate:report",
    "generate:report": "npx mochawesome-merge cypress/reports/mocha/*.json > cypress/reports/report.json && npx marge cypress/reports/report.json -o cypress/reports/html --inline",
    "report": "open cypress/reports/html/report.html",
    "cy:open": "cypress open"
  },
  
  
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "cypress": "^15.21.0",
    "mochawesome": "^8.0.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2"
  }
}
